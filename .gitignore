# Secrets: the RPC key must NEVER be committed
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv*/
venv/

# Temporary cache files (atomic write)
data/cache/**/*.tmp

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# NB: data/cache/ is committed ON PURPOSE → the demo runs without network.

# Local preview config (Python path specific to each machine)
.claude/launch.json

# ONLINE mode cache (backend v2): local log of responses, never committed
data/cache_live/

# ONLINE mode outputs (backend v2): regenerated on every analysis
output/live/
