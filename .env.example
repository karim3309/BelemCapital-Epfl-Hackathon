# Copy this file to `.env` (never committed) and put your own Ethereum mainnet RPC endpoint in it.
#
# - A public endpoint is enough to replay the cache or refresh at the "latest" block:
#   the PublicNode endpoint is cited by the guide https://main.net/guides/ethereum-mainnet-rpc-public-vs-private
#   → TO VERIFY yourselves before use.
# - To pin an OLD block (> ~128 blocks), you need an "archive" node
#   (e.g. a free Alchemy / Infura account: check in their docs that archive access is included).
ETH_RPC_URL=

# 1 = forbids every network call: everything must come from data/cache/ (demo mode).
STACKTRACE_OFFLINE=0
